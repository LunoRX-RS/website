---
import LegalPage from '../../sections/legal/LegalPage.astro';
import { legalDocs } from '../../sections/legal/documents';

export function getStaticPaths() {
	return Object.keys(legalDocs.th).map((slug) => ({ params: { slug } }));
}
---

<LegalPage lang="th" slug={Astro.params.slug as string} />
