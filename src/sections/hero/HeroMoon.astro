---
// Decorative scene. Bars are driven by the pointer and scroll (see motion/landing-motion.ts),
// never by an idle loop, so the page does not pretend that audio is playing.
const uid = Astro.props.uid ?? 'h';
const BARS = 96;
const bars = Array.from({ length: BARS }, (_, i) => {
	const len = 8 + 14 * Math.abs(Math.sin(i * 0.7) * Math.sin(i * 0.23 + 1));
	return { angle: (i / BARS) * 360, len: +len.toFixed(1) };
});
const stars = [[120, 150, 2], [690, 110, 1.6], [740, 480, 2.2], [90, 560, 1.8], [560, 740, 1.6], [250, 700, 2], [660, 650, 1.4], [330, 70, 1.6]];
---

<svg viewBox="0 0 800 800" class="size-full overflow-visible" role="img" aria-label={Astro.props.label} fill="none">
	<defs>
		<mask id={`moon-cut-${uid}`} maskUnits="userSpaceOnUse" x="200" y="200" width="400" height="400">
			<rect x="200" y="200" width="400" height="400" fill="#fff" />
			<circle cx="452" cy="372" r="104" fill="#000" />
		</mask>
	</defs>

	<g data-orbit="cw" style="transform-origin:400px 400px">
		<circle cx="400" cy="400" r="392" class="stroke-line" stroke-width="1.5" stroke-dasharray="2 11" stroke-linecap="round" />
		<circle cx="400" cy="38" r="6" class="fill-foreground" />
		<circle cx="676" cy="676" r="3.5" class="fill-muted-foreground" />
	</g>
	<g data-orbit="ccw" style="transform-origin:400px 400px">
		<circle cx="400" cy="400" r="318" class="stroke-line" stroke-width="1.5" />
		<rect x="708" y="392" width="16" height="16" rx="5" class="fill-surface stroke-foreground" stroke-width="1.5" transform="rotate(20 716 400)" />
		<circle cx="150" cy="590" r="4" class="fill-foreground" />
	</g>
	<circle cx="400" cy="400" r="246" class="stroke-line" stroke-width="1.5" stroke-dasharray="1 8" stroke-linecap="round" />

	<g data-bars style="transform-origin:400px 400px">
		{bars.map((b) => (
			<line data-bar data-len={b.len} x1="400" y1="236" x2="400" y2={236 - b.len} transform={`rotate(${b.angle} 400 400)`} class="stroke-muted-foreground" stroke-width="2.4" stroke-linecap="round" />
		))}
	</g>

	<g data-moon-core>
		<circle cx="400" cy="400" r="128" class="fill-foreground" mask={`url(#moon-cut-${uid})`} />
	</g>

	{stars.map(([x, y, r]) => <circle data-star cx={x} cy={y} r={r} class="fill-muted-foreground" />)}
</svg>
